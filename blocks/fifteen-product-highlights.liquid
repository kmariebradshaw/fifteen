<div class="fifteen-product-highlights" {{ block.shopify_attributes }}>
  <div><span class="fifteen-product-icon" style="--benefit-icon: url('{{ 'fifteen-icon-target.svg' | asset_url }}');" aria-hidden="true"></span><span>{{ block.settings.label_1 | escape }}</span></div>
  <div><span class="fifteen-product-icon" style="--benefit-icon: url('{{ 'fifteen-icon-backpack.svg' | asset_url }}');" aria-hidden="true"></span><span>{{ block.settings.label_2 | escape }}</span></div>
  <div><span class="fifteen-product-icon" style="--benefit-icon: url('{{ 'fifteen-icon-heart.svg' | asset_url }}');" aria-hidden="true"></span><span>{{ block.settings.label_3 | escape }}</span></div>
</div>

{% schema %}
{
  "name": "Fifteen highlights",
  "settings": [
    {
      "type": "text",
      "id": "label_1",
      "label": "Highlight 1",
      "default": "Exactly 15g"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Highlight 2",
      "default": "Easy to carry"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Highlight 3",
      "default": "Made for you"
    }
  ],
  "presets": [
    {
      "name": "Fifteen highlights"
    }
  ]
}
{% endschema %}
