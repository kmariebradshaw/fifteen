    },
    {
      "type": "color",
      "id": "pink",
      "label": "Pink",
      "default": "#e83f74"
    },
    {
      "type": "color",
      "id": "cream",
      "label": "Beige",
      "default": "#fffdf9"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Brand value",
      "limit": 3,
      "settings": [
        {
          "type": "select",
