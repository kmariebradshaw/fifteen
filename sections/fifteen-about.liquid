          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "shield",
            "heading": "Keep it simple",
            "text": "A clear 15g focus, convenient formats, and fewer things to figure out in a busy moment."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "award",
            "heading": "Made for real life",
            "text": "From school bags to bedside tables, essentials designed to fit into the routines you already have."
          }
        }
      ]
