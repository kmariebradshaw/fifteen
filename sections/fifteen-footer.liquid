<div class="fifteen-footer" style="--footer-navy: {{ section.settings.navy }}; --footer-pink: {{ section.settings.pink }}; --footer-values: {{ section.settings.values_background }};">
  <div class="fifteen-footer__main">
    <div class="fifteen-footer__inner fifteen-footer__main-grid">
      <div class="fifteen-footer__brand">
        <a class="fifteen-footer__logo" href="{{ routes.root_url }}" aria-label="Fifteen home">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '150, 250, 400', sizes: '150px', loading: 'lazy', alt: 'Fifteen' }}
          {% else %}
            <span class="fifteen-footer__wordmark" aria-hidden="true">15<span>FIFTEEN</span></span>
          {% endif %}
        </a>
        <div class="fifteen-footer__message">{{ section.settings.tagline }}</div>
      </div>
      <div class="fifteen-footer__newsletter">
        <h2>{{ section.settings.newsletter_heading | escape }}</h2>
        {% assign form_id = 'FifteenNewsletter-' | append: section.id %}
        {% form 'customer', id: form_id %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="fifteen-footer__sr-only" for="FifteenEmail-{{ section.id }}">Email address</label>
          <div class="fifteen-footer__email-row">
            <input id="FifteenEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ section.settings.email_placeholder | escape }}" required autocomplete="email" autocorrect="off" autocapitalize="off"{% if form.errors %} aria-invalid="true" aria-describedby="FifteenEmailError-{{ section.id }}"{% endif %}>
            <button type="submit">{{ section.settings.join_label | escape }}</button>
          </div>
          {% if form.errors %}
            <div class="fifteen-footer__feedback" id="FifteenEmailError-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          {% if form.posted_successfully? %}
            <p class="fifteen-footer__feedback" role="status">{{ section.settings.success_message | escape }}</p>
          {% endif %}
        {% endform %}
      </div>
      <div class="fifteen-footer__social">
        <h2>{{ section.settings.social_heading | escape }}</h2>
        <div class="fifteen-footer__social-links">
          {% assign networks = 'instagram,tiktok,facebook,youtube' | split: ',' %}
          {% for network in networks %}
            {% assign link_key = network | append: '_url' %}
            {% if section.settings[link_key] != blank %}
              <a href="{{ section.settings[link_key] }}" aria-label="{{ network | capitalize }}" target="_blank" rel="noopener noreferrer">{% render 'fifteen-footer-icon', name: network %}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
  {% if section.blocks.size > 0 %}
    <div class="fifteen-footer__values">
      <div class="fifteen-footer__inner fifteen-footer__values-grid">
        {% for block in section.blocks %}
          <div class="fifteen-footer__value" {{ block.shopify_attributes }}>
            <div class="fifteen-footer__value-icon">{% render 'fifteen-footer-icon', name: block.settings.icon %}</div>
            <div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .fifteen-footer { font-family: var(--font-body--family); color: #fff; }
  .fifteen-footer * { box-sizing: border-box; }
  .fifteen-footer__inner { max-width: 1600px; margin: 0 auto; padding-inline: clamp(1.25rem, 5vw, 6rem); }
  .fifteen-footer__main { background: var(--footer-navy); }
  .fifteen-footer__main-grid { display: grid; grid-template-columns: 1.5fr 1.15fr .55fr; gap: clamp(1.5rem, 3vw, 3rem); align-items: center; padding-block: clamp(2rem, 3vw, 3rem); }
  .fifteen-footer__brand { display: grid; grid-template-columns: auto 1fr; gap: clamp(1.2rem, 3vw, 3rem); align-items: center; }
  .fifteen-footer__logo { display: block; text-decoration: none; color: #fff; width: clamp(5rem, 7vw, 8rem); }
  .fifteen-footer__logo img { display: block; width: 100%; height: auto; }
  .fifteen-footer__wordmark { display: block; font-family: var(--font-heading--family); font-weight: 800; font-size: clamp(4rem, 6vw, 6.5rem); line-height: .9; letter-spacing: -.09em; text-align: center; }
  .fifteen-footer__wordmark > span { display: block; margin-top: .8rem; font-size: .8rem; line-height: 1; letter-spacing: .2em; }
  .fifteen-footer__message { border-left: 1px solid rgba(255,255,255,.8); padding-left: clamp(1.2rem, 3vw, 3rem); font-size: clamp(.85rem, 1.1vw, 1.1rem); line-height: 1.55; }
  .fifteen-footer__message p { margin: 0; }
  .fifteen-footer h2 { font: 750 clamp(.9rem, 1.2vw, 1.15rem)/1.2 var(--font-heading--family); color: #fff; letter-spacing: 0; margin: 0 0 1rem; }
  .fifteen-footer__newsletter, .fifteen-footer__social { min-width: 0; }
  .fifteen-footer__email-row { display: flex; border-radius: .75rem; background: #fff; }
  .fifteen-footer__email-row input { flex: 1; min-width: 0; width: 100%; padding: 1rem 1.1rem; border: 0; border-radius: .75rem 0 0 .75rem; background: #fff; color: #000000; font: inherit; font-size: .95rem; }
  .fifteen-footer__email-row input::placeholder { color: #555; opacity: 1; }
  .fifteen-footer__email-row button { flex: 0 0 auto; padding: 1rem 1.3rem; border: 0; border-radius: 0 .75rem .75rem 0; background: var(--footer-pink); color: #fff; font: inherit; font-weight: 750; cursor: pointer; }
  .fifteen-footer a:focus-visible, .fifteen-footer button:focus-visible, .fifteen-footer input:focus-visible { outline: 3px solid #92d7ef; outline-offset: 4px; }
  .fifteen-footer__social-links { display: flex; align-items: center; gap: clamp(.7rem, 1.25vw, 1.3rem); min-height: 3.3rem; }
  .fifteen-footer__social-links a { color: #fff; display: block; width: 1.8rem; flex-shrink: 0; }
  .fifteen-footer__social-links svg { display: block; width: 100%; height: auto; }
  .fifteen-footer__feedback { margin: .8rem 0 0; font-size: .85rem; }
  .fifteen-footer__feedback a { color: inherit; }
  .fifteen-footer__values { background: var(--footer-values); color: #000000; }
  .fifteen-footer__values-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; padding-block: 2rem; }
  .fifteen-footer__value { display: flex; gap: 1rem; align-items: center; }
  .fifteen-footer__value-icon { flex: 0 0 clamp(2.5rem, 4vw, 4rem); color: var(--footer-pink); }
  .fifteen-footer__value-icon svg { display: block; width: 100%; height: auto; }
  .fifteen-footer__value h3 { font: 750 clamp(.75rem, .95vw, .95rem)/1.25 var(--font-heading--family); letter-spacing: 0; color: #000000; margin: 0 0 .35rem; }
  .fifteen-footer__value p { margin: 0; font-size: clamp(.8rem, .95vw, .95rem); line-height: 1.5; }
  .fifteen-footer__sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 1100px) { .fifteen-footer__main-grid { grid-template-columns: 1fr 1fr; } .fifteen-footer__brand { grid-column: 1 / -1; max-width: 40rem; } .fifteen-footer__values-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .fifteen-footer__main-grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; } .fifteen-footer__brand { grid-column: auto; } .fifteen-footer__values-grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } .fifteen-footer__value-icon { flex-basis: 3.25rem; } .fifteen-footer__value h3 { font-size: .85rem; } .fifteen-footer__value p { font-size: .9rem; } }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .fifteen-footer__social-links a, .fifteen-footer__email-row button { transition: opacity .2s ease; } .fifteen-footer__social-links a:hover, .fifteen-footer__email-row button:hover { opacity: .8; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Fifteen footer",
  "tag": "footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Brand message",
      "default": "<p><strong>Simple. Reliable. Delicious.</strong><br>Everything you need for lows,<br>in exactly 15 grams.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "STAY IN THE KNOW"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "join_label",
      "label": "Signup button",
      "default": "JOIN"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Signup success message",
      "default": "Thanks for joining! You're on the list."
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "Tiktok link"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "Youtube link"
    },
    {
      "type": "color",
      "id": "navy",
      "label": "Dark background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "pink",
      "label": "Pink accent",
      "default": "#e83f74"
    },
    {
      "type": "color",
      "id": "values_background",
      "label": "Values background",
      "default": "#fff3f5"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Brand value",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "tube",
              "label": "Test tube"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "COMMUNITY DRIVEN"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "We give back and support the T1D community."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fifteen footer",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "award",
            "heading": "DIABETES-FOCUSED",
            "text": "Built by people who live it every day."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "shield",
            "heading": "QUALITY YOU TRUST",
            "text": "Carefully sourced ingredients. Made with care."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "tube",
            "heading": "CLINICALLY MINDED",
            "text": "Formulated for fast-acting carbohydrate delivery."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "heart",
            "heading": "COMMUNITY DRIVEN",
            "text": "We give back and support the T1D community."
          }
        }
      ]
    }
  ]
}
{% endschema %}
