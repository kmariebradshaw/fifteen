{
  "name": "Fifteen native homepage",
  "settings": [
    {"type":"url","id":"shop_link","label":"Shop button link"},
    {"type":"image_picker","id":"life_image_1","label":"At work image"},
    {"type":"image_picker","id":"life_image_2","label":"In the car image"},
    {"type":"image_picker","id":"life_image_3","label":"At the gym image"},
    {"type":"image_picker","id":"life_image_4","label":"Middle of the night image"},
    {"type":"image_picker","id":"life_image_5","label":"In your bag image"},
    {"type":"image_picker","id":"story_image","label":"Christian and Finn story photo"}
  ],
  "presets":[{"name":"Fifteen native homepage"}]
}
{% endschema %}
