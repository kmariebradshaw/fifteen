{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  assign product_limit = section.settings.products_to_show | default: 6 | plus: 0
  assign product_columns = product_limit
  if featured_collection.products.size > 0
    assign product_columns = featured_collection.products.size | at_most: product_limit
  endif
%}

<section class="fifteen-home" style="--fifteen-pink: {{ section.settings.accent_color }}; --fifteen-navy: {{ section.settings.navy_color }}; --fifteen-blue: {{ section.settings.hero_color }};">
  <div class="fifteen-home__hero page-width">
    <div class="fifteen-home__hero-copy">
      <h1>{{ section.settings.heading | replace: 'No Guesswork.', '<span class="fifteen-home__keep-together">No Guesswork.</span>' }}</h1>
      <svg class="fifteen-home__hero-underline" viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 15 Q200 0 396 11" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" /></svg>
      <div class="fifteen-home__hero-text rte">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}
        <a class="fifteen-home__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
    <div class="fifteen-home__hero-media fifteen-home__hero-media--gradient">
      <svg class="fifteen-home__wave fifteen-home__wave--desktop" viewBox="0 0 100 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 0 H65 C-30 160 125 350 45 600 H0 Z" fill="#fffdf9" />
      </svg>
      <svg class="fifteen-home__wave fifteen-home__wave--mobile" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 0 H600 V45 C400 125 200 -30 0 65 Z" fill="#fffdf9" />
      </svg>
      {% if section.settings.hero_accent_image != blank %}
        {{ section.settings.hero_accent_image | image_url: width: 1200 | image_tag: class: 'fifteen-home__hero-accent', loading: 'eager', widths: '400, 700, 1200', sizes: '(min-width: 750px) 34vw, 32vw', alt: 'Fifteen gummies, green apple rescue powder and grape drink shot' }}
      {% else %}
        <img class="fifteen-home__hero-accent" src="{{ 'fifteen-hero-accent.webp' | asset_url }}" width="1048" height="1501" loading="eager" fetchpriority="high" alt="Fifteen gummies, green apple rescue powder and grape drink shot">
      {% endif %}
      <div class="fifteen-home__carb-badge">
        <span>{{ section.settings.carb_eyebrow | escape }}</span>
        <strong>{{ section.settings.carb_amount | escape }}</strong>
        <span>{{ section.settings.carb_label | escape }}</span>
      </div>
    </div>
  </div>

  <div class="fifteen-home__benefits-wrap">
  <div class="fifteen-home__benefits page-width">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div class="fifteen-home__benefit" {{ block.shopify_attributes }}>
          {% liquid
            assign benefit_icon = ''
            case block.settings.icon
              when '◎'
                assign benefit_icon = 'fifteen-icon-target.svg'
              when 'ϟ'
                assign benefit_icon = 'fifteen-icon-lightning.svg'
              when '♧'
                assign benefit_icon = 'fifteen-icon-backpack.svg'
              when '☺'
                assign benefit_icon = 'fifteen-icon-smile.svg'
              when '♡'
                assign benefit_icon = 'fifteen-icon-heart.svg'
            endcase
          %}
          <span class="fifteen-home__benefit-icon" aria-hidden="true">
            {% if benefit_icon != blank %}
              <img src="{{ benefit_icon | asset_url }}" width="64" height="64" alt="" loading="lazy">
            {% else %}
              {{ block.settings.icon }}
            {% endif %}
          </span>
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  </div>

  <div class="fifteen-home__collection page-width">
    <h2>{{ section.settings.collection_heading }}</h2>
    <div class="fifteen-home__products" style="--product-columns: {{ product_columns }}; --product-columns-tablet: {{ product_columns | at_most: 3 }}; --product-columns-mobile: {{ product_columns | at_most: 2 }};">
      {% for product in featured_collection.products limit: product_limit %}
        <article class="fifteen-home__product">
          <a href="{{ product.url }}" class="fifteen-home__product-image">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '260, 430, 700', alt: product.featured_image.alt | escape }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </a>
          <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
          <div class="fifteen-home__product-description">{{ product.description | strip_html | truncate: 70 }}</div>
          <a class="fifteen-home__product-link" href="{{ product.url }}">SHOP {{ product.title | upcase }} <span aria-hidden="true">→</span></a>
        </article>
      {% else %}
        {% for i in (1..product_limit) %}
          <article class="fifteen-home__product fifteen-home__product--empty">
            <div class="fifteen-home__product-image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <h3>Product {{ i }}</h3>
            <div class="fifteen-home__product-description">Add products to the selected collection.</div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>


  {% if section.settings.show_story %}
    <section class="fifteen-home__story page-width" aria-labelledby="FifteenStory-{{ section.id }}">
      <fifteen-story-flip class="fifteen-home__story-flip">
        <div class="fifteen-home__flip-inner">
          <button class="fifteen-home__flip-front" data-flip-front type="button" aria-expanded="false" aria-controls="FifteenStoryBack-{{ section.id }}" aria-label="Our why">
            {% if section.settings.story_flip_image != blank %}
              {{ section.settings.story_flip_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 685, 1000, 1200', sizes: '(min-width: 750px) 48vw, 100vw', alt: section.settings.story_founders }}
            {% else %}
              <img src="{{ 'fifteen-story-family.webp' | asset_url }}" width="685" height="553" loading="lazy" alt="{{ section.settings.story_founders | escape }}">
            {% endif %}
            <span class="fifteen-home__flip-hint">Our why <span aria-hidden="true">↗</span></span>
          </button>
          <div class="fifteen-home__flip-back" id="FifteenStoryBack-{{ section.id }}" data-flip-back>
            <div class="fifteen-home__story-note">
              <span class="fifteen-home__story-heart" aria-hidden="true">♡</span>
              <p>For the lows.<br>For real life.<br>For families like ours.</p>
              <span>{{ section.settings.story_signature | escape }}</span>
            </div>
            <button type="button" class="fifteen-home__flip-return" data-flip-return>Back to photo</button>
          </div>
        </div>
      </fifteen-story-flip>
      <div class="fifteen-home__story-copy">
        <p class="fifteen-home__story-eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
        <h2 id="FifteenStory-{{ section.id }}">{{ section.settings.story_heading | escape }}<span>{{ section.settings.story_heading_accent | escape }}</span></h2>
        <svg class="fifteen-home__hero-underline" viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 15 Q200 0 396 11" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" /></svg>
        <div class="fifteen-home__story-text rte">{{ section.settings.story_text }}</div>
        <div class="fifteen-home__story-signoff">
          <span class="fifteen-home__story-signature">{{ section.settings.story_signature | escape }}</span>
          <p><strong>{{ section.settings.story_founders | escape }}</strong><span>{{ section.settings.story_role | escape }}</span></p>
        </div>
      </div>
    </section>
  {% endif %}

  <div class="fifteen-home__life page-width">
    <div class="fifteen-home__life-image">
      {% if section.settings.lifestyle_image != blank %}
        {{ section.settings.lifestyle_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', alt: section.settings.lifestyle_image.alt | escape }}
      {% else %}
        <div class="fifteen-home__life-placeholder">MADE<br>FOR REAL<br>LIFE</div>
      {% endif %}
    </div>
    <div class="fifteen-home__life-copy">
      <h2>{{ section.settings.lifestyle_heading }}</h2>
      <div class="rte">{{ section.settings.lifestyle_text }}</div>
      <div class="fifteen-home__moments">
        {% assign moments = 'School,Work,Gym,Travel,Bedside' | split: ',' %}
        {% for moment in moments %}
          <span class="fifteen-home__moment">
            {% render 'fifteen-moment-icon', name: moment %}
            <span class="fifteen-home__moment-label">{{ moment }}</span>
          </span>
        {% endfor %}
      </div>
    </div>
    <div class="fifteen-home__subscribe">
      <h2>{{ section.settings.subscribe_heading }}</h2>
      <div class="rte">{{ section.settings.subscribe_text }}</div>
      <ul class="fifteen-home__subscribe-benefits" role="list">
        {% for i in (1..3) %}
          {% assign benefit_key = 'subscribe_benefit_' | append: i %}
          {% if section.settings[benefit_key] != blank %}
            <li>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="11" fill="currentColor" />
                <path d="m7 12 3 3 7-7" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{{ section.settings[benefit_key] | escape }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      {% if section.settings.subscribe_button_label != blank %}
        <a class="fifteen-home__button" href="{{ section.settings.subscribe_button_link }}">{{ section.settings.subscribe_button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'fifteen-story-flip.js' | asset_url }}" defer></script>
<script src="{{ 'fifteen-motion.js' | asset_url }}" defer></script>

{% stylesheet %}
  .fifteen-home { background: #fffdf9; color: var(--fifteen-navy); overflow: hidden; }
  .fifteen-home .page-width { max-width: 1440px; margin: 0 auto; padding-left: clamp(1.25rem, 4vw, 4rem); padding-right: clamp(1.25rem, 4vw, 4rem); }
  .fifteen-home__hero { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: stretch; min-height: min(38vw, 630px); }
  .fifteen-home__hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(3.5rem, 8vw, 7.5rem) clamp(1rem, 5vw, 5rem) clamp(3.5rem, 8vw, 7.5rem) 0; }
  .fifteen-home__hero-copy h1, .fifteen-home h2, .fifteen-home h3 { color: var(--fifteen-navy); font-family: var(--font-heading--family); font-weight: 800; letter-spacing: -.055em; }
  .fifteen-home__hero-copy h1 { max-width: 100%; margin: 0; font-size: clamp(3.25rem, 5.6vw, 6.3rem); line-height: .95; }
  .fifteen-home__underline { width: min(20rem, 72%); height: .45rem; margin: 1rem 0 1.55rem; background: var(--fifteen-pink); border-radius: 99rem; transform: rotate(-2deg); }
  .fifteen-home__hero-underline { display: block; width: min(100%, 25rem); height: 1.25rem; margin: .3rem 0 1.4rem; color: var(--fifteen-pink); transform: rotate(-1deg); overflow: visible; }
  .fifteen-home__hero-text { max-width: 32rem; font-size: clamp(1rem, 1.35vw, 1.3rem); line-height: 1.52; }
  .fifteen-home__button { display: inline-flex; align-self: flex-start; margin-top: 1.8rem; padding: .9rem 1.55rem; border-radius: 99rem; background: var(--fifteen-pink); color: #fff; font-weight: 800; font-size: .82rem; letter-spacing: .02em; text-decoration: none; transition: transform .2s ease, filter .2s ease; }
  .fifteen-home__button:hover { color: #fff; filter: brightness(.94); transform: translateY(-2px); }
  .fifteen-home__hero-media { min-height: 100%; background: var(--fifteen-blue); overflow: hidden; }
  .fifteen-home__hero-image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fifteen-home__hero-placeholder { height: 100%; min-height: 30rem; display: grid; place-items: center; align-content: center; gap: 2rem; text-align: center; color: var(--fifteen-navy); background: radial-gradient(circle at 54% 43%, #fffdf9 0 19%, transparent 19.25%), linear-gradient(130deg, #b8e6f7, var(--fifteen-blue)); }
  .fifteen-home__dose { display: block; padding: 2rem; border-radius: 50%; background: #fffdf9; color: var(--fifteen-pink); font-size: 1rem; font-weight: 800; line-height: 1.2; }
  .fifteen-home__dose strong { font-size: 3.7rem; line-height: 1; }
  .fifteen-home__hero-placeholder p { margin: 0; font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; }
  .fifteen-home__benefits { display: grid; grid-template-columns: repeat(5, 1fr); padding-top: 2.25rem !important; padding-bottom: 2.25rem !important; }
  .fifteen-home__benefit { min-height: 9rem; padding: .3rem 1.25rem; text-align: center; border-right: 1px solid #e6e1d9; }
  .fifteen-home__benefit:last-child { border-right: 0; }
  .fifteen-home__benefit-icon { display: block; min-height: 2.5rem; color: var(--fifteen-pink); font-size: 2.3rem; line-height: 1; }
  .fifteen-home__benefit-icon img { display: block; width: clamp(3rem, 4.5vw, 4rem); height: auto; margin: 0 auto; }
  .fifteen-home__benefit h2 { margin: .65rem 0 .35rem; font-size: .82rem; letter-spacing: -.02em; }
  .fifteen-home__benefit p { margin: 0; font-size: .8rem; line-height: 1.38; }
  .fifteen-home__collection { padding-top: clamp(2.8rem, 5vw, 4.5rem) !important; padding-bottom: clamp(3rem, 6vw, 5rem) !important; }
  .fifteen-home__collection > h2, .fifteen-home__life-copy > h2 { margin: 0 0 1.7rem; font-size: clamp(1.65rem, 2.7vw, 2.6rem); line-height: 1; text-align: center; text-transform: uppercase; }
  .fifteen-home__products { display: grid; grid-template-columns: repeat(var(--product-columns, 6), minmax(0, 1fr)); gap: clamp(.65rem, 1.4vw, 1.4rem); }
  .fifteen-home__product { text-align: center; }
  .fifteen-home__product-image { display: block; aspect-ratio: .87; overflow: hidden; background: #e6f5f7; border-radius: .4rem; }
  .fifteen-home__product:nth-child(2n) .fifteen-home__product-image { background: #f9ddd3; }
  .fifteen-home__product:nth-child(3n) .fifteen-home__product-image { background: #e1def7; }
  .fifteen-home__product-image img, .fifteen-home__product-image svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fifteen-home__product h3 { margin: .9rem 0 .4rem; font-size: clamp(.75rem, 1vw, .95rem); line-height: 1.1; text-transform: uppercase; }
  .fifteen-home__product h3 a { color: inherit; text-decoration: none; }
  .fifteen-home__product-description { min-height: 2.5em; font-size: .72rem; line-height: 1.35; }
  .fifteen-home__product-link { display: inline-block; margin-top: .75rem; color: var(--fifteen-pink); font-size: .7rem; font-weight: 800; text-decoration: none; }
  .fifteen-home__life { display: grid; grid-template-columns: 1.05fr .95fr .92fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; padding-top: 2rem !important; padding-bottom: clamp(3rem, 6vw, 5rem) !important; }
  .fifteen-home__life-image { aspect-ratio: 1; overflow: hidden; border-radius: 50%; background: #fde9bd; }
  .fifteen-home__life-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fifteen-home__life-placeholder { display: grid; width: 100%; height: 100%; place-items: center; text-align: center; background: linear-gradient(135deg, #ffe5a6, #f7ba91); color: var(--fifteen-navy); font-family: var(--font-heading--family); font-size: clamp(1.8rem, 3.3vw, 3.5rem); font-weight: 800; line-height: .92; }
  .fifteen-home__life-copy > h2 { text-align: left; }
  .fifteen-home__life-copy .rte { font-size: 1rem; line-height: 1.55; }
  .fifteen-home__moments { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .4rem; margin-top: 1.6rem; color: var(--fifteen-navy); font-size: clamp(.6rem, .85vw, .78rem); font-weight: 700; }
  .fifteen-home__moment { display: flex; flex-direction: column; align-items: center; gap: .5rem; text-align: center; }
  .fifteen-home__moment svg { display: block; width: min(100%, 3rem); height: auto; aspect-ratio: 1; }
  .fifteen-home__moment-label { white-space: nowrap; }
  @media screen and (max-width: 749px) { .fifteen-home__moments { font-size: .75rem; } }
  .fifteen-home__subscribe { padding: clamp(1.5rem, 3vw, 2.8rem); border-radius: 1rem; background: #fff; box-shadow: 0 .5rem 2rem rgba(8, 35, 74, .1); }
  .fifteen-home__subscribe h2 { margin: 0 0 1rem; color: var(--fifteen-pink); font-size: clamp(1.6rem, 2.4vw, 2.45rem); line-height: .95; }
  .fifteen-home__subscribe .rte { font-size: .92rem; line-height: 1.5; }
  @media screen and (max-width: 989px) { .fifteen-home__hero { grid-template-columns: 1fr 1fr; } .fifteen-home__products { grid-template-columns: repeat(var(--product-columns-tablet, 3), minmax(0, 1fr)); row-gap: 2.2rem; } .fifteen-home__life { grid-template-columns: 1fr 1fr; } .fifteen-home__subscribe { grid-column: span 2; } }
  @media screen and (max-width: 749px) { .fifteen-home__hero { grid-template-columns: 1fr; } .fifteen-home__hero-copy { padding: 3.7rem 0 3rem; } .fifteen-home__hero-copy h1 { max-width: 100%; font-size: clamp(2.3rem, 8.8vw, 4rem); } .fifteen-home__hero-media { min-height: 24rem; } .fifteen-home__benefits { grid-template-columns: repeat(2, 1fr); } .fifteen-home__benefit { min-height: 8rem; padding: .8rem; border-bottom: 1px solid #e6e1d9; } .fifteen-home__benefit:nth-child(2n) { border-right: 0; } .fifteen-home__benefit:last-child { grid-column: span 2; } .fifteen-home__products { grid-template-columns: repeat(var(--product-columns-mobile, 2), minmax(0, 1fr)); } .fifteen-home__life { grid-template-columns: 1fr; } .fifteen-home__life-copy > h2 { text-align: center; } .fifteen-home__subscribe { grid-column: auto; } }

  .fifteen-home__story { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-top: clamp(2rem, 4vw, 4rem); padding-bottom: clamp(3rem, 6vw, 6rem); }
  .fifteen-home__story-media { overflow: hidden; border-radius: 1rem; background: #f9ddd3; }
  .fifteen-home__story-image { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .fifteen-home__story-note { min-height: 24rem; padding: clamp(2rem, 4vw, 4rem); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .fifteen-home__story-heart { color: var(--fifteen-pink); font-size: 4rem; line-height: 1; }
  .fifteen-home__story-note p { margin: 1.25rem 0; font-family: var(--font-heading--family); font-size: clamp(2rem, 3.4vw, 3.4rem); font-weight: 800; line-height: 1.05; letter-spacing: -.055em; }
  .fifteen-home__story-note > span:last-child { font-weight: 700; font-size: .9rem; }
  .fifteen-home__story-eyebrow { margin: 0 0 .85rem; color: var(--fifteen-navy); font-size: .8rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .fifteen-home__story-copy h2 { margin: 0; font-size: clamp(2rem, 3.3vw, 3.3rem); line-height: 1.05; text-transform: uppercase; }
  .fifteen-home__story-copy h2 > span { display: block; color: var(--fifteen-pink); }
  .fifteen-home__story-text { max-width: 38rem; font-size: 1rem; line-height: 1.65; }
  .fifteen-home__story-text p { margin: 0 0 1rem; }
  .fifteen-home__story-signoff { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
  .fifteen-home__story-signature { color: var(--fifteen-pink); font-family: var(--font-heading--family); font-weight: 800; font-style: italic; font-size: clamp(1.6rem, 2.5vw, 2.5rem); letter-spacing: -.04em; }
  .fifteen-home__story-signoff p { margin: 0; padding-left: 1rem; border-left: 2px solid #e6e1d9; font-size: .8rem; line-height: 1.5; }
  .fifteen-home__story-signoff p > span { display: block; }
  @media screen and (max-width: 749px) {
    .fifteen-home__story { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .fifteen-home__story-note { min-height: 18rem; }
    .fifteen-home__story-copy { min-width: 0; }
  }

  .fifteen-home .fifteen-home__hero { max-width: none; padding-right: 0; padding-left: max(clamp(1.25rem, 4vw, 4rem), calc((100% - 1440px) / 2 + 4rem)); background: #fffdf9; }
  .fifteen-home__benefits-wrap { background: #ffffff; }
  .fifteen-home__hero-media.fifteen-home__hero-media--gradient { position: relative; align-self: stretch; width: 100%; min-height: 28rem; container-type: inline-size; background: linear-gradient(120deg, var(--fifteen-blue) 0%, #d9f1fa 65%, #ffffff 100%); }
  .fifteen-home__wave { position: absolute; pointer-events: none; display: block; }
  .fifteen-home__wave--desktop { top: 0; left: -1px; width: 16%; height: 100%; }
  .fifteen-home__wave--mobile { display: none; }
  @media screen and (max-width: 749px) {
    .fifteen-home__hero-media.fifteen-home__hero-media--gradient { min-height: 20rem; aspect-ratio: 1.2; }
    .fifteen-home__wave--desktop { display: none; }
    .fifteen-home__wave--mobile { display: block; top: -1px; left: 0; width: 100%; height: 16%; }
    .fifteen-home__hero-media--gradient .fifteen-home__carb-badge { top: 20%; right: 5%; }
  }
  .fifteen-home__carb-badge { position: absolute; top: 5%; right: 3%; width: 32%; aspect-ratio: 1; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fffdf9; color: var(--fifteen-pink); font-family: var(--font-heading--family); font-weight: 800; text-align: center; line-height: 1.1; }
  .fifteen-home__carb-badge span { font-size: 3.6cqw; text-transform: uppercase; }
  .fifteen-home__carb-badge strong { display: block; margin: .035em 0; font-size: 10cqw; font-weight: 800; letter-spacing: -.06em; line-height: 1; }

  .fifteen-home__hero-accent {
    position: absolute;
    left: 2%;
    bottom: -2%;
    width: 63%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
}
  .fifteen-home__carb-badge { z-index: 1; }
  @media screen and (max-width: 749px) {
    .fifteen-home__hero-accent { left: 3%; bottom: 3%; width: 60%; height: 78%; }
  }

  .fifteen-home__story-flip { display: block; min-width: 0; perspective: 1200px; }
  .fifteen-home__flip-front, .fifteen-home__flip-return { display: none; }
  .fifteen-home__story-flip.is-ready .fifteen-home__flip-inner { display: grid; transform-style: preserve-3d; transition: transform .65s cubic-bezier(.2,.7,.2,1); }
  .fifteen-home__story-flip.is-flipped .fifteen-home__flip-inner { transform: rotateY(180deg); }
  .fifteen-home__story-flip.is-ready .fifteen-home__flip-front,
  .fifteen-home__story-flip.is-ready .fifteen-home__flip-back { grid-area: 1 / 1; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 1rem; }
  .fifteen-home__story-flip.is-ready .fifteen-home__flip-front { display: block; position: relative; width: 100%; min-height: 26rem; padding: 0; border: 0; overflow: hidden; cursor: pointer; background: #f9ddd3; color: #fff; }
  .fifteen-home__flip-front img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .fifteen-home__flip-hint { position: absolute; bottom: 1rem; right: 1rem; padding: .7rem 1rem; border-radius: 99rem; background: var(--fifteen-navy); font: inherit; font-weight: 700; }
  .fifteen-home__story-flip.is-ready .fifteen-home__flip-back { transform: rotateY(180deg); position: relative; background: #f9ddd3; padding: 0 0 3rem; }
  .fifteen-home__story-flip.is-ready .fifteen-home__flip-return { display: inline-block; position: absolute; bottom: 1rem; left: clamp(2rem, 4vw, 4rem); margin-top: 0; border: 0; border-bottom: 1px solid currentColor; padding: .35rem 0; background: transparent; color: var(--fifteen-navy); font: inherit; cursor: pointer; }
  .fifteen-home__flip-front:focus-visible, .fifteen-home__flip-return:focus-visible { outline: 3px solid var(--fifteen-pink); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .fifteen-home__story-flip.is-ready .fifteen-home__flip-inner { transition: none; } }

  .fifteen-home__subscribe-benefits { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: .7rem; }
  .fifteen-home__subscribe-benefits:empty { display: none; }
  .fifteen-home__subscribe-benefits li { display: flex; align-items: flex-start; gap: .6rem; font-size: .9rem; line-height: 1.4; }
  .fifteen-home__subscribe-benefits svg { flex: 0 0 1.25rem; width: 1.25rem; height: 1.25rem; color: var(--fifteen-pink); }

  @media (prefers-reduced-motion: no-preference) {
    .fifteen-home__button { transition: transform .25s ease, filter .25s ease, box-shadow .25s ease; }
    .fifteen-home__product-image img { transition: transform .55s cubic-bezier(.2,.65,.3,1); }
    .fifteen-home__benefit-icon img, .fifteen-home__moment svg { transition: transform .3s ease; }
    .fifteen-home__product-link { transition: color .2s ease; }
    .fifteen-home__product-link > span { display: inline-block; transition: transform .25s ease; }
    .fifteen-home__button:active { transform: translateY(0) scale(.98); }
    @media (hover: hover) and (pointer: fine) {
      .fifteen-home__button:hover { transform: translateY(-3px); box-shadow: 0 .45rem 1rem rgba(7,31,72,.14); }
      .fifteen-home__product:hover .fifteen-home__product-image img { transform: scale(1.035); }
      .fifteen-home__product:hover .fifteen-home__product-link > span { transform: translateX(.25rem); }
      .fifteen-home__benefit:hover .fifteen-home__benefit-icon img,
      .fifteen-home__moment:hover svg { transform: translateY(-.2rem); }
    }
    .fifteen-home__product:focus-within .fifteen-home__product-image img { transform: scale(1.035); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fifteen-home__button, .fifteen-home__product-image img,
    .fifteen-home__benefit-icon img, .fifteen-home__moment svg,
    .fifteen-home__product-link > span { transition: none; }
    .fifteen-home__button:hover { transform: none; }
  }


  /* Keep the desktop composition on phones, giving the copy most of the width. */
  @media screen and (max-width: 749px) {
    .fifteen-home .fifteen-home__hero {
      grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr);
      min-height: 0;
      padding-left: 1.1rem;
      padding-right: 0;
    }
    .fifteen-home .fifteen-home__hero-copy {
      min-width: 0;
      padding: 2.5rem .65rem 2.5rem 0;
    }
    .fifteen-home .fifteen-home__hero-copy h1 {
      font-size: clamp(1.9rem, 6.7vw, 3rem);
      line-height: 1;
      overflow-wrap: break-word;
    }
    .fifteen-home .fifteen-home__hero-underline {
      height: .8rem;
      margin: .35rem 0 1rem;
    }
    .fifteen-home .fifteen-home__hero-text {
      font-size: 1rem;
      line-height: 1.45;
    }
    .fifteen-home .fifteen-home__hero-copy .fifteen-home__button {
      margin-top: 1.2rem;
      padding: .8rem 1rem;
      max-width: 100%;
      text-align: center;
      justify-content: center;
    }
    .fifteen-home .fifteen-home__hero-media--gradient {
      min-height: 0;
      aspect-ratio: auto;
    }
    .fifteen-home .fifteen-home__wave--desktop {
      display: block;
      width: 16%;
      height: 100%;
    }
    .fifteen-home .fifteen-home__wave--mobile { display: none; }
    .fifteen-home .fifteen-home__hero-accent {
      left: 6%;
      bottom: 10%;
      width: 90%;
      height: 60%;
      object-position: center bottom;
    }
    .fifteen-home .fifteen-home__hero-media--gradient .fifteen-home__carb-badge {
      top: 8%;
      right: 7%;
      width: 65%;
    }
    .fifteen-home .fifteen-home__carb-badge span { font-size: clamp(.6rem, 6cqw, 1rem); }
    .fifteen-home .fifteen-home__carb-badge strong { font-size: clamp(1.5rem, 20cqw, 3rem); }
  }


  /* Size against the actual text column and keep the closing phrase intact. */
  .fifteen-home .fifteen-home__hero-copy { container-type: inline-size; }
  .fifteen-home .fifteen-home__hero-copy h1 {
    font-size: min(clamp(3.25rem, 5.6vw, 6.3rem), 12cqw);
  }
  .fifteen-home__keep-together { white-space: nowrap; }
  @media screen and (max-width: 749px) {
    .fifteen-home .fifteen-home__hero-copy h1 {
      font-size: min(clamp(1.9rem, 6.7vw, 3rem), 12cqw);
    }
  }


  /* Give the mobile badge and product cutout separate space. */
  @media screen and (max-width: 749px) {
    .fifteen-home .fifteen-home__hero-underline {
      width: 74%;
      max-width: 18rem;
    }
    .fifteen-home .fifteen-home__hero-accent {
      bottom: 3%;
      height: 53%;
      width: 86%;
      left: 9%;
    }
    .fifteen-home .fifteen-home__hero-media--gradient .fifteen-home__carb-badge {
      top: 6%;
      right: 10%;
      width: 50%;
    }
    .fifteen-home .fifteen-home__carb-badge span {
      font-size: clamp(.5rem, 4.8cqw, .8rem);
    }
    .fifteen-home .fifteen-home__carb-badge strong {
      font-size: clamp(1.2rem, 15cqw, 2.3rem);
    }
  }

