kground:linear-gradient(#dce1e3,#899196)}.f15__scoop-copy{position:absolute;right:0;bottom:-15px;font:700 18px/1.1 cursive;text-align:center;margin:0}.f15__scoop-copy small{font-size:12px}.f15__flavor-note{position:absolute;top:95px;right:0;font:700 30px/1.1 cursive;transform:rotate(-5deg)}.f15__flavor-note:after{content:"";display:block;height:7px;background:var(--lime);border-radius:999px;margin-top:6px;transform:rotate(-6deg)}.f15__flavor-pills{position:absolute;right:1%;bottom:105px;display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end;width:320px}.f15__flavor-pills button{border:0;border-radius:999px;background:#eef1ef;padding:7px 10px;font-size:10px;font-weight:900;cursor:pointer}.f15__flavor-pills button.is-active{background:var(--flavor);color:#fff}.f15__real-life{padding-top:22px;padding-bottom:30px}.f15__section-heading{display:flex;align-items:center;gap:12px;margin-bottom:14px}.f15__section-heading p,.f15__section-heading h2{margin:0;font:900 26px/1 cursive}.f15__section-heading h2{font-family:Arial,Helvetica,sans-serif}.f15__section-heading i,.f15__center-heading i,.f15__community-hand i{display:block;width:90px;height:6px;background:var(--lime);border-radius:99px}.f15__life-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:11px}.f15__life-card{text-align:center}.f15__media-placeholder{aspect-ratio:1.17;background:linear-gradient(135deg,#e7ece9,#cdd7d2);border-radius:6px;overflow:hidden;display:grid;place-items:center;color:#50635b;font-weight:900;font-size:12px;letter-spacing:.08em}.f15__media-placeholder img{width:100%;height:100%;object-fit:cover;display:block}.f15__life-card h3{font-size:13px;margin:8px 0 3px;text-transform:uppercase}.f15__life-card p{font-size:11px;line-height:1.25;margin:0}.f15__products{padding-top:10px;padding-bottom:38px}.f15__center-heading{text-align:center;margin-bottom:18px}.f15__center-heading h2{font-size:30px;letter-spacing:-.04em;margin:0}.f15__center-heading i{margin:6px auto 0;width:75px}.f15__product-g