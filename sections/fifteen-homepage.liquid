{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
%}

<section class="fifteen-home" style="--fifteen-pink: {{ section.settings.accent_color }}; --fifteen-navy: {{ section.settings.navy_color }}; --fifteen-blue: {{ section.settings.hero_color }};">
  <div class="fifteen-home__hero page-width">
    <div class="fifteen-home__hero-copy">
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      <div class="fifteen-home__underline" aria-hidden="true"></div>
      <div class="fifteen-home__hero-text rte">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}
        <a class="fifteen-home__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
    <div class="fifteen-home__hero-media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1800 | image_tag: class: 'fifteen-home__hero-image', loading: 'eager', widths: '750, 1100, 1500, 1800', alt: section.settings.hero_image.alt | escape }}
      {% else %}
        <div class="fifteen-home__hero-placeholder">
          <span class="fifteen-home__dose">EXACTLY<br><strong>15g</strong><br>CARBS</span>
          <p>Real product photography<br>coming soon</p>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="fifteen-home__benefits page-width">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div class="fifteen-home__benefit" {{ block.shopify_attributes }}>
          <span class="fifteen-home__benefit-icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="fifteen-home__collection page-width">
    <h2>{{ section.settings.collection_heading }}</h2>
    <div class="fifteen-home__products">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        <article class="fifteen-home__product">
          <a href="{{ product.url }}" class="fifteen-home__product-image">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '260, 430, 700', alt: product.featured_image.alt | escape }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </a>
          <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
          <div class="fifteen-home__product-description">{{ product.description | strip_html | truncate: 70 }}</div>
          <a class="fifteen-home__product-link" href="{{ product.url }}">SHOP {{ product.title | upcase }} <span aria-hidden="true">→</span></a>
        </article>
      {% else %}
        {% for i in (1..6) %}
          <article class="fifteen-home__product fifteen-home__product--empty">
            <div class="fifteen-home__product-image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <h3>Product {{ i }}</h3>
            <div class="fifteen-home__product-description">Add products to the selected collection.</div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <div class="fifteen-home__life page-width">
    <div class="fifteen-home__life-image">
      {% if section.settings.lifestyle_image != blank %}
        {{ section.settings.lifestyle_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', alt: section.settings.lifestyle_image.alt | escape }}
      {% else %}
        <div class="fifteen-home__life-placeholder">MADE<br>FOR REAL<br>LIFE</div>
      {% endif %}
    </div>
    <div class="fifteen-home__life-copy">
      <h2>{{ section.settings.lifestyle_heading }}</h2>
      <div class="rte">{{ section.settings.lifestyle_text }}</div>
      <div class="fifteen-home__moments">
        <span>School</span><span>Work</span><span>Gym</span><span>Travel</span><span>Bedside</span>
      </div>
    </div>
    <div class="fifteen-home__subscribe">
      <h2>{{ section.settings.subscribe_heading }}</h2>
      <div class="rte">{{ section.settings.subscribe_text }}</div>
      {% if section.settings.subscribe_button_label != blank %}
        <a class="fifteen-home__button" href="{{ section.settings.subscribe_button_link }}">{{ section.settings.subscribe_button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fifteen-home { background: #fffdf9; color: var(--fifteen-navy); overflow: hidden; }
  .fifteen-home .page-width { max-width: 1440px; margin: 0 auto; padding-left: clamp(1.25rem, 4vw, 4rem); padding-right: clamp(1.25rem, 4vw, 4rem); }
  .fifteen-home__hero { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); align-items: stretch; min-height: min(38vw, 630px); }
  .fifteen-home__hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(3.5rem, 8vw, 7.5rem) clamp(1rem, 5vw, 5rem) clamp(3.5rem, 8vw, 7.5rem) 0; }
  .fifteen-home__hero-copy h1, .fifteen-home h2, .fifteen-home h3 { color: var(--fifteen-navy); font-family: var(--font-heading--family); font-weight: 800; letter-spacing: -.055em; }
  .fifteen-home__hero-copy h1 { max-width: 11ch; margin: 0; font-size: clamp(3.25rem, 5.6vw, 6.3rem); line-height: .95; }
  .fifteen-home__underline { width: min(20rem, 72%); height: .45rem; margin: 1rem 0 1.55rem; background: var(--fifteen-pink); border-radius: 99rem; transform: rotate(-2deg); }
  .fifteen-home__hero-text { max-width: 32rem; font-size: clamp(1rem, 1.35vw, 1.3rem); line-height: 1.52; }
  .fifteen-home__button { display: inline-flex; align-self: flex-start; margin-top: 1.8rem; padding: .9rem 1.55rem; border-radius: 99rem; background: var(--fifteen-pink); color: #fff; font-weight: 800; font-size: .82rem; letter-spacing: .02em; text-decoration: none; transition: transform .2s ease, filter .2s ease; }
  .fifteen-home__button:hover { color: #fff; filter: brightness(.94); transform: translateY(-2px); }
  .fifteen-home__hero-media { min-height: 100%; background: var(--fifteen-blue); overflow: hidden; }
  .fifteen-home__hero-image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fifteen-home__hero-placeholder { height: 100%; min-height: 30rem; display: grid; place-items: center; align-content: center; gap: 2rem; text-align: center; color: var(--fifteen-navy); background: radial-gradient(circle at 54% 43%, #fffdf9 0 19%, transparent 19.25%), linear-gradient(130deg, #b8e6f7, var(--fifteen-blue)); }
  .fifteen-home__dose { display: block; padding: 2rem; border-radius: 50%; background: #fffdf9; color: var(--fifteen-pink); font-size: 1rem; font-weight: 800; line-height: 1.2; }
  .fifteen-home__dose strong { font-size: 3.7rem; line-height: 1; }
  .fifteen-home__hero-placeholder p { margin: 0; font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; }
  .fifteen-home__benefits { display: grid; grid-template-columns: repeat(5, 1fr); padding-top: 2.25rem !important; padding-bottom: 2.25rem !important; }
  .fifteen-home__benefit { min-height: 9rem; padding: .3rem 1.25rem; text-align: center; border-right: 1px solid #e6e1d9; }
  .fifteen-home__benefit:last-child { border-right: 0; }
  .fifteen-home__benefit-icon { display: block; min-height: 2.5rem; color: var(--fifteen-pink); font-size: 2.3rem; line-height: 1; }
  .fifteen-home__benefit h2 { margin: .65rem 0 .35rem; font-size: .82rem; letter-spacing: -.02em; }
  .fifteen-home__benefit p { margin: 0; font-size: .8rem; line-height: 1.38; }
  .fifteen-home__collection { padding-top: clamp(2.8rem, 5vw, 4.5rem) !important; padding-bottom: clamp(3rem, 6vw, 5rem) !important; }
  .fifteen-home__collection > h2, .fifteen-home__life-copy > h2 { margin: 0 0 1.7rem; font-size: clamp(1.65rem, 2.7vw, 2.6rem); line-height: 1; text-align: center; text-transform: uppercase; }
  .fifteen-home__products { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(.65rem, 1.4vw, 1.4rem); }
  .fifteen-home__product { text-align: center; }
  .fifteen-home__product-image { display: block; aspect-ratio: .87; overflow: hidden; background: #e6f5f7; border-radius: .4rem; }
  .fifteen-home__product:nth-child(2n) .fifteen-home__product-image { background: #f9ddd3; }
  .fifteen-home__product:nth-child(3n) .fifteen-home__product-image { background: #e1def7; }
  .fifteen-home__product-image img, .fifteen-home__product-image svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fifteen-home__product h3 { margin: .9rem 0 .4rem; font-size: clamp(.75rem, 1vw, .95rem); line-height: 1.1; text-transform: uppercase; }
  .fifteen-home__product h3 a { color: inherit; text-decoration: none; }
  .fifteen-home__product-description { min-height: 2.5em; font-size: .72rem; line-height: 1.35; }
  .fifteen-home__product-link { display: inline-block; margin-top: .75rem; color: var(--fifteen-pink); font-size: .7rem; font-weight: 800; text-decoration: none; }
  .fifteen-home__life { display: grid; grid-template-columns: 1.05fr .95fr .92fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; padding-top: 2rem !important; padding-bottom: clamp(3rem, 6vw, 5rem) !important; }
  .fifteen-home__life-image { aspect-ratio: 1; overflow: hidden; border-radius: 50%; background: #fde9bd; }
  .fifteen-home__life-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fifteen-home__life-placeholder { display: grid; width: 100%; height: 100%; place-items: center; text-align: center; background: linear-gradient(135deg, #ffe5a6, #f7ba91); color: var(--fifteen-navy); font-family: var(--font-heading--family); font-size: clamp(1.8rem, 3.3vw, 3.5rem); font-weight: 800; line-height: .92; }
  .fifteen-home__life-copy > h2 { text-align: left; }
  .fifteen-home__life-copy .rte { font-size: 1rem; line-height: 1.55; }
  .fifteen-home__moments { display: flex; flex-wrap: wrap; gap: .7rem 1rem; margin-top: 1.6rem; color: var(--fifteen-navy); font-size: .78rem; font-weight: 700; }
  .fifteen-home__moments span { border-bottom: 2px solid var(--fifteen-pink); padding-bottom: .25rem; }
  .fifteen-home__subscribe { padding: clamp(1.5rem, 3vw, 2.8rem); border-radius: 1rem; background: #fff; box-shadow: 0 .5rem 2rem rgba(8, 35, 74, .1); }
  .fifteen-home__subscribe h2 { margin: 0 0 1rem; color: var(--fifteen-pink); font-size: clamp(1.6rem, 2.4vw, 2.45rem); line-height: .95; }
  .fifteen-home__subscribe .rte { font-size: .92rem; line-height: 1.5; }
  @media screen and (max-width: 989px) { .fifteen-home__hero { grid-template-columns: 1fr 1fr; } .fifteen-home__products { grid-template-columns: repeat(3, 1fr); row-gap: 2.2rem; } .fifteen-home__life { grid-template-columns: 1fr 1fr; } .fifteen-home__subscribe { grid-column: span 2; } }
  @media screen and (max-width: 749px) { .fifteen-home__hero { grid-template-columns: 1fr; } .fifteen-home__hero-copy { padding: 3.7rem 0 3rem; } .fifteen-home__hero-copy h1 { max-width: 10ch; } .fifteen-home__hero-media { min-height: 24rem; } .fifteen-home__benefits { grid-template-columns: repeat(2, 1fr); } .fifteen-home__benefit { min-height: 8rem; padding: .8rem; border-bottom: 1px solid #e6e1d9; } .fifteen-home__benefit:nth-child(2n) { border-right: 0; } .fifteen-home__benefit:last-child { grid-column: span 2; } .fifteen-home__products { grid-template-columns: repeat(2, 1fr); } .fifteen-home__life { grid-template-columns: 1fr; } .fifteen-home__life-copy > h2 { text-align: center; } .fifteen-home__subscribe { grid-column: auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "15 Fifteen homepage",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One Dose.\n15 Grams.\nNo Guesswork." },
    { "type": "richtext", "id": "text", "label": "Hero text", "default": "<p>Delicious, convenient foods and drinks with exactly 15 grams of fast-acting carbohydrates—made for life with type 1 diabetes.</p>" },
    { "type": "text", "id": "button_label", "label": "Hero button label", "default": "SHOP THE COLLECTION" },
    { "type": "url", "id": "button_link", "label": "Hero button link" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#e83f74" },
    { "type": "color", "id": "navy_color", "label": "Navy color", "default": "#071f48" },
    { "type": "color", "id": "hero_color", "label": "Hero placeholder color", "default": "#92d7ef" },
    { "type": "header", "content": "Collection" },
    { "type": "text", "id": "collection_heading", "label": "Heading", "default": "MEET THE 15 COLLECTION" },
    { "type": "collection", "id": "collection", "label": "Products collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "header", "content": "Lifestyle" },
    { "type": "image_picker", "id": "lifestyle_image", "label": "Lifestyle image" },
    { "type": "text", "id": "lifestyle_heading", "label": "Heading", "default": "MADE FOR REAL LIFE" },
    { "type": "richtext", "id": "lifestyle_text", "label": "Text", "default": "<p>Whether you're at school, at work, at practice, or on an adventure—15 is here for your lows, so you can get back to your highs.</p>" },
    { "type": "text", "id": "subscribe_heading", "label": "Subscribe heading", "default": "NEVER BE WITHOUT 15" },
    { "type": "richtext", "id": "subscribe_text", "label": "Subscribe text", "default": "<p>Subscribe and save on your favorite 15g essentials.</p>" },
    { "type": "text", "id": "subscribe_button_label", "label": "Subscribe button label", "default": "SUBSCRIBE & SAVE" },
    { "type": "url", "id": "subscribe_button_link", "label": "Subscribe button link" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "limit": 5, "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "◎" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "EXACTLY 15g" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "No counting. No guessing." }
    ] }
  ],
  "presets": [{ "name": "15 Fifteen homepage", "blocks": [
    { "type": "benefit", "settings": { "icon": "◎", "heading": "EXACTLY 15g", "text": "No counting. No guessing." } },
    { "type": "benefit", "settings": { "icon": "ϟ", "heading": "FAST-ACTING", "text": "Designed to help raise low blood sugar." } },
    { "type": "benefit", "settings": { "icon": "♧", "heading": "EASY TO CARRY", "text": "Fits in your pocket, bag, or anywhere." } },
    { "type": "benefit", "settings": { "icon": "☺", "heading": "GREAT TASTE", "text": "Foods and drinks you'll actually enjoy." } },
    { "type": "benefit", "settings": { "icon": "♡", "heading": "MADE FOR YOU", "text": "Created by people who get it." } }
  ] }]
}
{% endschema %}
