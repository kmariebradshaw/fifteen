{% liquid
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
  assign names = 'Green Apple,Cherry,Grape,Watermelon,Blue Raspberry' | split: ','
  assign keys = 'apple,cherry,grape,watermelon,blue' | split: ','
%}

<section class="f15" data-fifteen-home>
  <div class="f15__hero">
    <div class="f15__wrap f15__hero-grid">
      <div class="f15__hero-copy">
        <p class="f15__eyebrow">FOR LIFE'S LOWS</p>
        <h1><span class="f15__headline-line">WHEN LOW</span> <span class="f15__headline-line">HITS, REACH</span> <span class="f15__headline-line">FOR <span class="f15__headline-accent">FIFTEEN.</span></span></h1>
        <p class="f15__lead">15g of fast-acting carbohydrates in a small, convenient powder.</p>

        <div class="f15__benefits" aria-label="Product benefits">
          <div><span class="f15__benefit-icon">↯</span><span>FAST-ACTING<br>CARBS</span></div>
          <div><span class="f15__benefit-icon">◉</span><span>DISSOLVES ON<br>YOUR TONGUE</span></div>
          <div><span class="f15__benefit-icon">◇</span><span>SMALL.<br>PORTABLE.</span></div>
        </div>

        <a class="f15__button f15__button--lime" href="{{ shop_url }}">SHOP RESCUE POWDER <span>→</span></a>
        <p class="f15__hand">Designed by a diabetic for diabetics.</p>
      </div>

      <div class="f15__hero-stage">
        <div class="f15__packet-row" data-packet-row>
          {% for name in names %}
            <button class="f15__packet {{ keys[forloop.index0] }}{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-flavor="{{ keys[forloop.index0] }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="f15__packet-seal"></span>
              <span class="f15__packet-logo">15<small>FIFTEEN</small></span>
              <span class="f15__packet-name">RESCUE<br>POWDER</span>
              <span class="f15__packet-sub">FAST-ACTING<br>CARBOHYDRATES</span>
              <span class="f15__packet-dose">15g</span>
              <span class="f15__packet-flavor">{{ name }}</span>
            </button>
          {% endfor %}
        </div>

        <div class="f15__powder-demo">
          <div class="f15__powder-pile apple is-active" data-powder="apple"></div>
          <div class="f15__powder-pile cherry" data-powder="cherry"></div>
          <div class="f15__powder-pile grape" data-powder="grape"></div>
          <div class="f15__powder-pile watermelon" data-powder="watermelon"></div>
          <div class="f15__powder-pile blue" data-powder="blue"></div>
          <div class="f15__spoon">
            <span class="f15__spoon-bowl"><i data-spoon-powder class="apple"></i></span>
            <span class="f15__spoon-handle"></span>
          </div>
          <p class="f15__scoop-copy">Full scoop = 15g carbs<br><small>Shown for size reference</small></p>
        </div>

        <div class="f15__flavor-note">15g. Five great flavors.</div>
        <div class="f15__flavor-pills" aria-label="Select a flavor">
          {% for name in names %}
            <button type="button" class="{{ keys[forloop.index0] }}{% if forloop.first %} is-active{% endif %}" data-flavor-pill="{{ keys[forloop.index0] }}">{{ name }}</button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <section class="f15__real-life f15__wrap">
    <div class="f15__section-heading">
      <p>REAL LIFE.</p>
      <h2>SAME 15g.</h2>
      <i></i>
    </div>
    <div class="f15__life-grid">
      {% assign labels = 'At work,In the car,At the gym,Middle of the night,In your bag' | split: ',' %}
      {% assign body = 'Meetings, deadlines, and peace of mind.|Ready wherever the day takes you.|Treat a low and keep moving.|Quick access without leaving bed.|A small backup that goes everywhere.' | split: '|' %}
      {% for label in labels %}
        {% assign key = 'life_image_' | append: forloop.index %}
        <article class="f15__life-card">
          <div class="f15__media-placeholder">
            {% if section.settings[key] != blank %}
              {{ section.settings[key] | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,640,1000', sizes: '(min-width: 990px) 18vw, 46vw', alt: label }}
            {% else %}
              <span>PHOTO<br>PLACEHOLDER</span>
            {% endif %}
          </div>
          <h3>{{ label }}</h3>
          <p>{{ body[forloop.index0] }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="f15__products f15__wrap">
    <div class="f15__center-heading">
      <h2>THREE WAYS TO STAY READY</h2>
      <i></i>
    </div>

    <div class="f15__product-grid">
      <article class="f15__product-card">
        <div class="f15__product-visual">
          <div class="f15__box-pack">
            <strong>15</strong><small>FIFTEEN</small><b>RESCUE POWDER</b><em>15 PACKETS</em>
          </div>
          <div class="f15__single apple"><strong>15</strong><small>RESCUE<br>POWDER</small></div>
        </div>
        <div class="f15__product-copy">
          <h3>RESCUE POWDER 15-PACK</h3>
          <p>15 single-serve packets. Keep them in your desk, car, gym bag, nightstand, or backpack.</p>
          <a class="f15__button f15__button--navy" href="{{ shop_url }}">SHOP 15-PACK <span>→</span></a>
        </div>
      </article>

      <article class="f15__product-card">
        <div class="f15__product-visual">
          <div class="f15__bulk-bag">
            <span class="f15__servings">50<small>SERVINGS</small></span>
            <strong>15</strong><small>FIFTEEN</small><b>RESCUE POWDER</b><em>FAST-ACTING CARBOHYDRATES</em>
            <div class="f15__dots"><i class="apple"></i><i class="cherry"></i><i class="grape"></i><i class="watermelon"></i><i class="blue"></i></div>
          </div>
          <div class="f15__travel-pouch">15</div>
        </div>
        <div class="f15__product-copy">
          <h3>RESCUE POWDER 50-SERVE BAG</h3>
          <p>50 servings in a resealable bag, with reusable small bags for everyday carry.</p>
          <a class="f15__button f15__button--navy" href="{{ shop_url }}">SHOP 50-SERVE <span>→</span></a>
        </div>
      </article>

      <article class="f15__product-card">
        <div class="f15__product-visual">
          <div class="f15__bulk-bag">
            <strong>15</strong><small>FIFTEEN</small><b>RESCUE SPHERES</b><em>FAST-ACTING CARBOHYDRATES</em>
            <div class="f15__spheres"><i class="apple"></i><i class="cherry"></i><i class="grape"></i><i class="watermelon"></i><i class="blue"></i></div>
          </div>
        </div>
        <div class="f15__product-copy">
          <h3>RESCUE SPHERES</h3>
          <p>Porous, crunchy rescue spheres with the look and feel of a freeze-dried hard candy.</p>
          <a class="f15__button f15__button--navy" href="{{ shop_url }}">SHOP RESCUE SPHERES <span>→</span></a>
        </div>
      </article>
    </div>
  </section>

  <section class="f15__story">
    <div class="f15__wrap f15__story-grid">
      <div class="f15__story-media">
        {% if section.settings.story_image != blank %}
          {{ section.settings.story_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,800,1200,1400', sizes: '(min-width: 900px) 46vw, 100vw', alt: 'Christian and Finn Arquilla' }}
        {% else %}
          <img src="{{ 'fifteen-story-family.webp' | asset_url }}" width="685" height="553" loading="lazy" alt="Christian and Finn Arquilla">
        {% endif %}
      </div>
      <div class="f15__story-copy">
        <p class="f15__eyebrow f15__eyebrow--green">OUR STORY</p>
        <h2>A FATHER. A BETTER SOLUTION.</h2>
        <p>I'm Christian, a dad and entrepreneur. My son Finn was diagnosed with Type 1 diabetes, and together we've experienced the daily highs and lows that come with it.</p>
        <p>We created Fifteen to make treating lows simpler, faster, and more convenient — because we live the problem.</p>
        <p>We wanted something small enough for real life, easy to use, and built around the 15g rule people with diabetes already know.</p>
        <div class="f15__signatures"><span>Christian</span><span>Finn</span></div>
        <small>Christian and Finn Arquilla<br>Founders, Fifteen</small>
      </div>
    </div>
  </section>

  <section class="f15__community f15__wrap">
    <div class="f15__community-head">
      <div>
        <h2>A COMMUNITY THAT GETS IT</h2>
        <p>Real life with Type 1 — at work, at school, at the gym, on the road, and at home.</p>
      </div>
      <a href="{{ shop_url }}">JOIN THE #FIFTEENCOMMUNITY →</a>
    </div>

    <div class="f15__community-grid">
      {% for i in (1..5) %}
        {% assign image_key = 'community_image_' | append: i %}
        <article class="f15__community-card">
          <div class="f15__community-photo">
            {% if section.settings[image_key] != blank %}
              {{ section.settings[image_key] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,520,900', sizes: '(min-width: 990px) 20vw, 50vw', alt: 'Fifteen Type 1 community member' }}
            {% else %}
              <span>TYPE 1<br>COMMUNITY<br>PHOTO</span>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <p class="f15__community-hand">Different lives. Same 15g.<i></i></p>
  </section>
</section>

<script>
(() => {
  const root = document.querySelector('[data-fifteen-home]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const setFlavor = (flavor) => {
    root.querySelectorAll('[data-flavor]').forEach((el) => {
      const active = el.dataset.flavor === flavor;
      el.classList.toggle('is-active', active);
      el.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    root.querySelectorAll('[data-flavor-pill]').forEach((el) => {
      el.classList.toggle('is-active', el.dataset.flavorPill === flavor);
    });
    root.querySelectorAll('[data-powder]').forEach((el) => {
      el.classList.toggle('is-active', el.dataset.powder === flavor);
    });
    const spoonPowder = root.querySelector('[data-spoon-powder]');
    if (spoonPowder) spoonPowder.className = flavor;
  };

  root.querySelectorAll('[data-flavor], [data-flavor-pill]').forEach((el) => {
    el.addEventListener('click', () => setFlavor(el.dataset.flavor || el.dataset.flavorPill));
  });
})();
</script>

{% stylesheet %}
