{% liquid
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
%}

<section class="f15-native" style="--navy:#071f48;--lime:#93e52f;--ink:#071f48;--soft:#f7f8f4;">
  <div class="f15-hero">
    <div class="f15-wrap f15-hero-grid">
      <div class="f15-hero-copy">
        <p class="f15-kicker">FOR LIFE'S LOWS</p>
        <h1>WHEN LOW<br>HITS, REACH<br>FOR <span>FIFTEEN.</span></h1>
        <p class="f15-lead">15g of fast-acting carbohydrates<br>in a small, convenient powder.</p>

        <div class="f15-benefits">
          <div><b>↯</b><span>RAISES<br>BLOOD SUGAR<br>FAST</span></div>
          <div><b>◉</b><span>DISSOLVES<br>ON YOUR TONGUE<br>IN SECONDS</span></div>
          <div><b>⬡</b><span>SMALL.<br>PORTABLE.<br>ANYWHERE.</span></div>
        </div>

        <a class="f15-cta" href="{{ shop_url }}">SHOP RESCUE POWDER <span>→</span></a>
        <p class="f15-script">Designed by a diabetic for diabetics.</p>
      </div>

      <div class="f15-hero-products" aria-label="Five Fifteen rescue powder flavors">
        <div class="f15-packets">
          {% assign names = 'GREEN APPLE,CHERRY,GRAPE,WATERMELON,BLUE RASPBERRY' | split: ',' %}
          {% assign classes = 'apple,cherry,grape,watermelon,blue' | split: ',' %}
          {% for name in names %}
            <div class="f15-packet {{ classes[forloop.index0] }}">
              <div class="f15-packet-top"></div>
              <div class="f15-packet-logo">15<small>FIFTEEN</small></div>
              <strong>RESCUE<br>POWDER</strong>
              <em>FAST-ACTING<br>CARBOHYDRATES</em>
              <span>15g</span>
              <b>{{ name }}</b>
            </div>
          {% endfor %}
        </div>
        <div class="f15-powders">
          {% for name in names %}
            <span class="f15-powder {{ classes[forloop.index0] }}"></span>
          {% endfor %}
        </div>
        <div class="f15-spoon">
          <span class="f15-spoon-bowl"></span><span class="f15-spoon-handle"></span>
          <span class="f15-spoon-powder"></span>
        </div>
        <div class="f15-flavor-note">Same 15g.<br>Five Great<br>Flavors.</div>
        <div class="f15-scoop-note">← Full scoop = 15g carbs<br><small>(for size reference)</small></div>
      </div>
    </div>
  </div>

  <div class="f15-wrap f15-life">
    <div class="f15-life-title">REAL LIFE.<br>SAME 15g.<i></i></div>
    {% assign labels = 'AT WORK,IN THE CAR,AT THE GYM,IN THE MIDDLE OF THE NIGHT,IN YOUR BAG' | split: ',' %}
    {% assign copy = 'Meetings, deadlines, and peace of mind.|Be ready wherever the day takes you.|Stay fueled and keep going.|Quickly treat lows and get back to rest.|Small enough to go anywhere.' | split: '|' %}
    {% for label in labels %}
      {% assign key = 'life_image_' | append: forloop.index %}
      <div class="f15-life-card">
        <div class="f15-life-photo life-{{ forloop.index }}">
          {% if section.settings[key] != blank %}
            {{ section.settings[key] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,520,900', sizes: '(min-width: 900px) 17vw, 44vw', alt: label }}
          {% else %}
            <div class="f15-life-fallback">
              {% case forloop.index %}
                {% when 1 %}💻
                {% when 2 %}🚗
                {% when 3 %}🏋
                {% when 4 %}🌙
                {% when 5 %}🎒
              {% endcase %}
            </div>
          {% endif %}
        </div>
        <h3>{{ label }}</h3>
        <p>{{ copy[forloop.index0] }}</p>
      </div>
    {% endfor %}
  </div>

  <section class="f15-ready f15-wrap">
    <h2>THREE WAYS TO STAY READY<i></i></h2>
    <div class="f15-ready-grid">
      <article class="f15-product-card">
        <div class="f15-product-art f15-15pack">
          <div class="f15-box">15<small>FIFTEEN</small><b>RESCUE POWDER</b><strong>15</strong><em>PACKETS</em></div>
          <div class="f15-mini-packet">15<small>RESCUE<br>POWDER</small></div>
        </div>
        <h3>RESCUE POWDER 15-PACK</h3>
        <p>15 single-serve packets.<br>Take them anywhere.</p>
        <a href="{{ shop_url }}">SHOP 15-PACK <span>→</span></a>
      </article>

      <article class="f15-product-card">
        <div class="f15-product-art f15-bag">
          <div class="f15-bag-shape">
            <span class="f15-50">50<small>SERVINGS</small></span>
            <div class="f15-bag-logo">15<small>FIFTEEN</small></div>
            <b>RESCUE POWDER</b>
            <em>FAST-ACTING CARBOHYDRATES</em>
            <div class="f15-flavor-dots">
              <i class="apple"></i><i class="cherry"></i><i class="grape"></i><i class="watermelon"></i><i class="blue"></i>
            </div>
            <small>GREEN APPLE | CHERRY | GRAPE<br>WATERMELON | BLUE RASPBERRY</small>
          </div>
          <div class="f15-travel-bag">15</div>
        </div>
        <h3>RESCUE POWDER 50-SERVE BAG</h3>
        <p>50 servings in a resealable bag<br>with reusable travel bags.</p>
        <a href="{{ shop_url }}">SHOP 50-SERVE <span>→</span></a>
      </article>

      <article class="f15-product-card">
        <div class="f15-product-art f15-bag">
          <div class="f15-bag-shape">
            <div class="f15-bag-logo">15<small>FIFTEEN</small></div>
            <b>RESCUE SPHERES</b>
            <em>FAST-ACTING CARBOHYDRATES</em>
            <div class="f15-spheres">
              <i class="apple"></i><i class="cherry"></i><i class="grape"></i><i class="watermelon"></i><i class="blue"></i>
            </div>
            <small>GREEN APPLE | CHERRY | GRAPE<br>WATERMELON | BLUE RASPBERRY</small>
          </div>
        </div>
        <h3>RESCUE SPHERES</h3>
        <p>15g of fast-acting carbs in a<br>crunchy, great-tasting sphere.</p>
        <a href="{{ shop_url }}">SHOP RESCUE SPHERES <span>→</span></a>
      </article>
    </div>
  </section>

  <section class="f15-story">
    <div class="f15-wrap f15-story-grid">
      <div class="f15-story-photo">
        {% if section.settings.story_image != blank %}
          {{ section.settings.story_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,800,1200,1400', sizes: '(min-width:900px) 45vw,100vw', alt: 'Christian and Finn Arquilla' }}
        {% else %}
          <img src="{{ 'fifteen-story-family.webp' | asset_url }}" alt="Christian and Finn Arquilla" width="685" height="553" loading="lazy">
        {% endif %}
      </div>
      <div class="f15-story-copy">
        <p class="f15-story-kicker">OUR STORY</p>
        <h2>A FATHER. A BETTER SOLUTION.</h2>
        <p>I'm Christian, a dad, entrepreneur, and a person living with type 1 diabetes.</p>
        <p>My son Finn was diagnosed with Type 1, and together we've experienced the daily highs and lows that come with it. We created Fifteen to make treating lows simpler, faster, and more convenient — because we live the problem, not lived.</p>
        <p>Fifteen is designed by <strong>a diabetic for diabetics</strong>, because no one understands the need for a better solution more than we do.</p>
        <div class="f15-signatures"><span>Christian</span><span>Finn</span></div>
        <small>Christian and Finn Arquilla<br>Founders, Fifteen</small>
      </div>
    </div>
  </section>

  <section class="f15-community f15-wrap">
    <div class="f15-community-head">
      <div><h2>A COMMUNITY THAT GETS IT</h2><p>Real people. Real stories. Real life with Type 1.</p></div>
      <a href="{{ shop_url }}">JOIN THE #FIFTEENCOMMUNITY →</a>
    </div>
    <div class="f15-community-grid">
      <article><div class="avatar">◉</div><blockquote>“Fifteen gives me confidence to handle lows anywhere.”</blockquote><small>— T1D since 2010</small></article>
      <article><div class="avatar">🎒</div><blockquote>“I keep it in my backpack every day.”</blockquote><small>— T1D since 2018</small></article>
      <article class="f15-community-center"><div class="shirts"><span>TYPE ONE<br>STRONG</span><span>TYPE ONE<br>STRONG</span><span>TYPE ONE<br>STRONG</span><span>TYPE ONE<br>STRONG</span></div></article>
      <article><div class="avatar">◉</div><blockquote>“Fast, easy, and actually tastes great.”</blockquote><small>— T1D since 2016</small></article>
      <article><div class="avatar">🧢</div><blockquote>“It's in my car, my bag, and my nightstand. Always ready.”</blockquote><small>— T1D since 1998</small></article>
    </div>
    <p class="f15-community-script">Different Lives. Same 15g.<i></i></p>
  </section>
</section>

{% stylesheet %}
.f15-native{background:#fff;color:var(--ink);font-family:Arial,Helvetica,sans-serif;overflow:hidden}.f15-wrap{width:min(1440px,100%);margin:auto;padding-left:clamp(18px,4vw,58px);padding-right:clamp(18px,4vw,58px)}.f15-hero{background:linear-gradient(90deg,#f7f7f3 0 46%,#fff 46%)}.f15-hero-grid{display:grid;grid-template-columns:.78fr 1.22fr;min-height:610px;align-items:center}.f15-kicker{font-weight:900;letter-spacing:.08em;margin:0 0 8px;font-size:18px}.f15-hero h1{font-weight:1000;letter-spacing:-.055em;line-height:.9;font-size:clamp(54px,5.6vw,92px);margin:0;color:var(--navy)}.f15-hero h1 span{color:var(--lime)}.f15-lead{font-size:clamp(18px,1.55vw,26px);line-height:1.25;margin:18px 0 22px}.f15-benefits{display:flex;gap:30px;margin:10px 0 18px}.f15-benefits>div{display:flex;align-items:center;gap:10px}.f15-benefits b{font-size:36px}.f15-benefits span{font-weight:800;font-size:12px;line-height:1.05}.f15-cta{display:flex;justify-content:center;gap:18px;align-items:center;background:var(--lime);color:#081d3c;text-decoration:none;font-weight:900;border-radius:999px;padding:16px 24px;width:min(100%,390px);font-size:17px}.f15-script{font-family:cursive;font-style:italic;font-weight:700;font-size:26px;margin:12px 0 0 6px;transform:rotate(-2deg);text-decoration:underline;text-decoration-color:var(--lime);text-decoration-thickness:6px;text-underline-offset:6px}.f15-hero-products{position:relative;min-height:610px;display:flex;align-items:center;justify-content:center;padding:80px 20px 120px}.f15-packets{display:flex;align-items:flex-end;gap:10px;z-index:2}.f15-packet{width:110px;height:330px;border-radius:8px 8px 12px 12px;background:linear-gradient(#fff 0 77%,var(--flavor) 77%);box-shadow:0 12px 28px #001c4824;display:flex;flex-direction:column;align-items:center;text-align:center;padding:22px 10px 12px;position:relative;border:1px solid #e7e7e7}.f15-packet:before{content:"";position:absolute;top:0;left:0;right:0;height:20px;background:var(--flavor);border-radius:8px 8px 0 0}.f15-packet-logo{font-size:54px;font-weight:1000;font-style:italic;line-height:.8;color:#111;margin-top:18px}.f15-packet-logo small{display:block;font-size:10px;letter-spacing:.1em;font-style:normal;margin-top:6px}.f15-packet strong{font-size:13px;line-height:.95;margin-top:18px}.f15-packet em{font-size:7px;font-style:normal;margin-top:7px}.f15-packet>span{font-size:10px;font-weight:800;margin-top:8px}.f15-packet>b{font-size:10px;color:#fff;margin-top:auto}.apple{--flavor:#7ccf2b}.cherry{--flavor:#e21e2f}.grape{--flavor:#7435b7}.watermelon{--flavor:#ef4672}.blue{--flavor:#0d9fe5}.f15-powders{position:absolute;bottom:92px;left:16%;right:18%;display:flex;justify-content:space-around;z-index:1}.f15-powder{width:72px;height:36px;background:var(--flavor);clip-path:polygon(0 100%,50% 0,100% 100%);filter:saturate(.8) brightness(1.25)}.f15-spoon{position:absolute;bottom:34px;right:2%;width:440px;height:78px;transform:rotate(-3deg)}.f15-spoon-bowl{position:absolute;left:0;top:9px;width:160px;height:66px;border-radius:50%;background:linear-gradient(180deg,#e9edf0,#9aa2a7);box-shadow:inset 0 7px 9px #ffffffaa}.f15-spoon-handle{position:absolute;left:140px;top:35px;width:300px;height:20px;border-radius:999px;background:linear-gradient(#dce2e5,#868f95)}.f15-spoon-powder{position:absolute;left:38px;top:13px;width:84px;height:40px;background:#ef4672;clip-path:polygon(0 100%,50% 0,100% 100%)}.f15-flavor-note{position:absolute;right:0;top:122px;font:700 31px/1.1 cursive;transform:rotate(-5deg)}.f15-flavor-note:after{content:"";display:block;height:7px;background:var(--lime);border-radius:99px;transform:rotate(-8deg);margin-top:9px}.f15-scoop-note{position:absolute;right:4%;bottom:0;font:700 22px/1.15 cursive;text-align:center}.f15-scoop-note small{font-size:15px}.f15-life{display:grid;grid-template-columns:140px repeat(5,1fr);gap:10px;padding-top:12px;padding-bottom:18px;align-items:start}.f15-life-title{font:900 28px/.95 cursive;align-self:center;transform:rotate(-5deg)}.f15-life-title i,.f15-ready h2 i,.f15-community-script i{display:block;width:95%;height:6px;background:var(--lime);border-radius:99px;margin-top:8px}.f15-life-photo{aspect-ratio:1.16;border-radius:5px;overflow:hidden;background:#eef1ef}.f15-life-photo img{width:100%;height:100%;object-fit:cover;display:block}.f15-life-fallback{width:100%;height:100%;display:grid;place-items:center;font-size:54px;background:linear-gradient(135deg,#e3e9e6,#cdd8d2)}.f15-life-card h3{font-size:14px;text-align:center;margin:7px 0 2px}.f15-life-card p{font-size:11px;line-height:1.2;text-align:center;margin:0}.f15-ready{padding-top:10px;padding-bottom:28px}.f15-ready>h2{text-align:center;font-weight:1000;letter-spacing:-.04em;font-size:30px;margin:0 0 16px}.f15-ready>h2 i{width:70px;margin:4px auto 0}.f15-ready-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.f15-product-card{text-align:center}.f15-product-art{height:310px;background:#f4f6f5;border-radius:7px;display:flex;align-items:center;justify-content:center;position:relative}.f15-box{width:170px;height:225px;background:#fff;border:1px solid #dde1e3;box-shadow:0 9px 25px #001c4814;display:flex;flex-direction:column;align-items:center;padding:20px;font-weight:1000;font-style:italic;font-size:78px;line-height:.65}.f15-box small{font-size:12px;margin:10px}.f15-box b{font-size:17px;line-height:1;font-style:normal;margin-top:18px}.f15-box strong{font-size:44px;line-height:1;margin-top:auto}.f15-box em{font-size:11px;font-style:normal}.f15-mini-packet{position:absolute;right:13%;bottom:24px;width:70px;height:150px;background:linear-gradient(#fff 0 72%,#7ccf2b 72%);box-shadow:0 9px 20px #001c481c;font-size:42px;font-weight:1000;font-style:italic;padding-top:30px}.f15-mini-packet small{display:block;font-size:8px;font-style:normal}.f15-bag-shape{width:285px;height:245px;background:#fff;border:1px solid #dfe4e5;border-radius:10px 10px 22px 22px;box-shadow:0 9px 25px #001c4813;padding:18px;display:flex;flex-direction:column;align-items:center;position:relative}.f15-bag-shape:before{content:"";position:absolute;left:0;right:0;top:17px;border-top:2px solid #e8ecec}.f15-50{position:absolute;left:16px;top:11px;font-size:25px;font-weight:1000}.f15-50 small{display:block;font-size:6px}.f15-bag-logo{font-size:62px;font-weight:1000;font-style:italic;line-height:.72;margin-top:28px}.f15-bag-logo small{display:block;font-size:10px;letter-spacing:.15em;font-style:normal;margin-top:8px}.f15-bag-shape>b{font-size:18px;margin-top:16px}.f15-bag-shape>em{font-size:8px;font-style:normal}.f15-bag-shape>small{font-size:8px;font-weight:800;line-height:1.4}.f15-flavor-dots,.f15-spheres{display:flex;gap:7px;margin:14px 0 7px}.f15-flavor-dots i{width:25px;height:16px;border-radius:50% 50% 30% 30%;background:var(--flavor);display:block}.f15-spheres i{width:31px;height:31px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffffff66 0 5%,transparent 6%),radial-gradient(circle at 70% 70%,#00000018 0 4%,transparent 5%),var(--flavor);display:block;box-shadow:inset 0 0 8px #0002}.f15-travel-bag{position:absolute;right:11%;bottom:20px;width:55px;height:95px;background:#fff;border:1px solid #ddd;display:grid;place-items:center;font-weight:1000}.f15-product-card h3{font-size:18px;margin:9px 0 4px}.f15-product-card p{font-size:14px;line-height:1.25;margin:0 0 11px}.f15-product-card>a{display:flex;justify-content:center;gap:18px;align-items:center;background:var(--navy);color:#fff;text-decoration:none;font-weight:900;border-radius:999px;padding:14px 18px;margin:0 auto;width:min(100%,290px);font-size:13px}.f15-story{background:#f7f8f4}.f15-story-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:stretch;padding-left:0}.f15-story-photo{min-height:420px}.f15-story-photo img{width:100%;height:100%;object-fit:cover;display:block}.f15-story-copy{padding:28px 58px;display:flex;flex-direction:column;justify-content:center}.f15-story-kicker{color:#79c91e;font-weight:900;margin:0 0 5px}.f15-story-copy h2{font-size:33px;letter-spacing:-.04em;margin:0 0 8px}.f15-story-copy p{font-size:15px;line-height:1.35;margin:0 0 7px}.f15-signatures{display:flex;gap:48px;margin:8px 0;font:italic 34px cursive}.f15-story-copy small{font-size:11px}.f15-community{padding-top:20px;padding-bottom:28px}.f15-community-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:10px}.f15-community-head h2{font-size:31px;letter-spacing:-.04em;margin:0}.f15-community-head p{margin:0;font-size:15px}.f15-community-head>a{border:1px solid var(--navy);border-radius:999px;padding:10px 20px;text-decoration:none;color:var(--navy);font-weight:800;font-size:12px}.f15-community-grid{display:grid;grid-template-columns:1fr 1fr 1.45fr 1fr 1fr;gap:8px}.f15-community-grid article{min-height:180px;background:#eef2ef;border-radius:4px;padding:16px;display:flex;flex-direction:column;justify-content:center}.f15-community-grid .avatar{font-size:46px}.f15-community-grid blockquote{font:700 16px/1.15 cursive;margin:7px 0}.f15-community-grid small{font-size:9px}.f15-community-center{padding:0!important;background:linear-gradient(#efa45e,#fdc480)!important}.shirts{display:flex;justify-content:center;align-items:center;gap:8px;height:100%}.shirts span{background:#1c2836;color:#fff;padding:28px 8px 22px;border-radius:28px 28px 5px 5px;font-size:10px;text-align:center;font-weight:800}.f15-community-script{text-align:center;font:italic 30px cursive;margin:10px auto 0;width:max-content}.f15-community-script i{width:170px;margin:0 auto}.f15-native a{transition:transform .18s ease,filter .18s ease}.f15-native a:hover{transform:translateY(-2px);filter:brightness(.97)}

@media(max-width:1100px){.f15-hero-grid{grid-template-columns:.9fr 1.1fr}.f15-packet{width:82px;height:285px}.f15-packet-logo{font-size:42px}.f15-flavor-note{display:none}.f15-spoon{width:330px}.f15-spoon-handle{width:210px}.f15-life{grid-template-columns:110px repeat(5,1fr)}}
@media(max-width:800px){.f15-hero{background:#f7f7f3}.f15-hero-grid{grid-template-columns:1fr}.f15-hero-copy{padding-top:34px}.f15-hero h1{font-size:clamp(48px,13vw,72px)}.f15-hero-products{min-height:530px;padding:55px 0 110px}.f15-packets{gap:5px;transform:scale(.84)}.f15-benefits{gap:14px;flex-wrap:wrap}.f15-life{grid-template-columns:repeat(2,1fr)}.f15-life-title{grid-column:1/-1;text-align:center}.f15-life-card:last-child{grid-column:1/-1;width:50%;justify-self:center}.f15-ready-grid{grid-template-columns:1fr}.f15-product-art{height:300px}.f15-story-grid{grid-template-columns:1fr;padding-right:0}.f15-story-copy{padding:26px 20px}.f15-community-head{align-items:flex-start;gap:14px;flex-direction:column}.f15-community-grid{grid-template-columns:1fr 1fr}.f15-community-center{grid-column:1/-1}.f15-community-grid article{min-height:150px}}
@media(max-width:520px){.f15-wrap{padding-left:14px;padding-right:14px}.f15-kicker{font-size:14px}.f15-lead{font-size:17px}.f15-benefits>div{gap:6px}.f15-benefits b{font-size:28px}.f15-benefits span{font-size:10px}.f15-script{font-size:20px}.f15-hero-products{margin-left:-8px;margin-right:-8px}.f15-packets{transform:scale(.62);width:150%;margin-left:-25%;margin-right:-25%}.f15-powders{bottom:96px}.f15-spoon{transform:scale(.72) rotate(-3deg);transform-origin:right bottom}.f15-scoop-note{font-size:16px}.f15-life{gap:12px}.f15-ready>h2,.f15-community-head h2{font-size:26px}.f15-story-photo{min-height:300px}.f15-community-grid{grid-template-columns:1fr}.f15-community-center{grid-column:auto}.f15-community-script{font-size:25px}}
{% endstylesheet %}

