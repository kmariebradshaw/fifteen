{{ 'fifteen-product.css' | asset_url | stylesheet_tag }}
<section class="fifteen-product-benefits" aria-labelledby="FifteenBenefits-{{ section.id }}">
  <div class="fifteen-product-benefits__inner">
    <header>
      <p class="fifteen-product-benefits__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="FifteenBenefits-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.intro | escape }}</p>
    </header>
    <div class="fifteen-product-benefits__grid">
      {% for block in section.blocks %}
        {% assign icon_asset = 'fifteen-icon-' | append: block.settings.icon | append: '.svg' %}
        <article class="fifteen-product-benefits__card fifteen-product-benefits__card--{{ block.settings.icon }}" {{ block.shopify_attributes }}>
          <img src="{{ icon_asset | asset_url }}" width="56" height="56" alt="" loading="lazy">
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </article>
      {% endfor %}
    </div>
    {% if section.settings.show_lifestyle %}
      <div class="fifteen-product-benefits__life">
        <div><p class="fifteen-product-benefits__eyebrow">{{ section.settings.lifestyle_eyebrow | escape }}</p>
          <h2>{{ section.settings.lifestyle_heading | escape }}</h2>
          <p>{{ section.settings.lifestyle_text | escape }}</p>
        </div>
        <ul class="fifteen-product-benefits__moments" role="list">
          {% assign moments = 'School,Work,Gym,Travel,Bedside' | split: ',' %}
          {% for moment in moments %}
            <li>{% render 'fifteen-moment-icon', name: moment %}<span>{{ moment }}</span></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Fifteen product benefits",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FIFTEEN DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small essentials. Big everyday difference."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Simple, reliable essentials made to fit into your day."
    },
    {
      "type": "checkbox",
      "id": "show_lifestyle",
      "label": "Show lifestyle panel",
      "default": true
    },
    {
      "type": "text",
      "id": "lifestyle_eyebrow",
      "label": "Lifestyle eyebrow",
      "default": "WHEREVER THE DAY TAKES YOU"
    },
    {
      "type": "text",
      "id": "lifestyle_heading",
      "label": "Lifestyle heading",
      "default": "Made for real life."
    },
    {
      "type": "textarea",
      "id": "lifestyle_text",
      "label": "Lifestyle text",
      "default": "Busy mornings, long afternoons and everything in between. Make room for Fifteen in your everyday routine."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon and color",
          "options": [
            {
              "value": "target",
              "label": "Pink target"
            },
            {
              "value": "lightning",
              "label": "Blue lightning"
            },
            {
              "value": "backpack",
              "label": "Green backpack"
            },
            {
              "value": "smile",
              "label": "Gold smile"
            },
            {
              "value": "heart",
              "label": "Purple heart"
            }
          ],
          "default": "target"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Exactly 15g."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Simple essentials for your everyday routine."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fifteen product benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "target",
            "heading": "Exactly 15g. Simply Fifteen.",
            "text": "Clearly portioned carbohydrates, so there is one less thing to figure out."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "backpack",
            "heading": "Small enough for real life.",
            "text": "Keep your favorites close, from your everyday bag to your bedside drawer."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "smile",
            "heading": "Find your favorite.",
            "text": "Gummies, powder or a shot. A collection with different tastes and formats to choose from."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "heading": "A little more personal.",
            "text": "Inspired by Christian and Finn, and the everyday experience of life with Type 1 diabetes."
          }
        }
      ]
    }
  ]
}
{% endschema %}
