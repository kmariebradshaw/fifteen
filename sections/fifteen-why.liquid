<article class="fifteen-why" style="--why-navy: {{ section.settings.navy }}; --why-pink: {{ section.settings.pink }}; --why-cream: {{ section.settings.cream }};">
  <header class="fifteen-why__hero fifteen-why__width">
    <div>
      <p class="fifteen-why__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | replace: 'Less guesswork.', 'Less&nbsp;guesswork.' }}</h1>
      <svg class="fifteen-why__underline" viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 15 Q200 0 396 11" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/></svg>
      <div class="rte">{{ section.settings.intro }}</div>
    </div>
    <div class="fifteen-why__hero-art">
      <div class="fifteen-why__badge">
        <span>{{ section.settings.badge_top | escape }}</span>
        <strong>{{ section.settings.badge_amount | escape }}</strong>
        <span>{{ section.settings.badge_bottom | escape }}</span>
      </div>
    </div>
  </header>
  <section class="fifteen-why__benefits fifteen-why__width">
    <div class="fifteen-why__section-heading">
      <h2>{{ section.settings.benefits_heading }}</h2>
      <div class="rte">{{ section.settings.benefits_intro }}</div>
    </div>
    <div class="fifteen-why__benefit-grid">
      {% for block in section.blocks %}
        <div class="fifteen-why__benefit" {{ block.shopify_attributes }}>
          {% assign icon_asset = 'fifteen-icon-' | append: block.settings.icon | append: '.svg' %}
          <img src="{{ icon_asset | asset_url }}" alt="" width="64" height="64" loading="lazy">
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {% endfor %}
    </div>
  </section>
  <section class="fifteen-why__portion-wrap">
    <div class="fifteen-why__portion fifteen-why__width">
      <h2>{{ section.settings.portion_heading }}</h2>
      <div class="rte">{{ section.settings.portion_text }}</div>
    </div>
  </section>
  <section class="fifteen-why__formats fifteen-why__width">
    <h2>{{ section.settings.formats_heading }}</h2>
    <svg class="fifteen-why__underline" viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 15 Q200 0 396 11" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/></svg>
    <div class="rte">{{ section.settings.formats_text }}</div>
    {% assign formats_collection = section.settings.product_collection | default: collections.all %}
    {% if formats_collection.products.size > 0 %}
      <div class="fifteen-why__product-gallery">
        {% for format_product in formats_collection.products limit: 3 %}
          <a class="fifteen-why__product-card" href="{{ format_product.url }}">
            {% if format_product.featured_image != blank %}
              {{ format_product.featured_image | image_url: width: 900 | image_tag: widths: '240, 360, 540, 720, 900', sizes: '(min-width: 750px) 28vw, 80vw', loading: 'lazy', alt: format_product.title }}
            {% endif %}
            <span>{{ format_product.title | escape }} <span aria-hidden="true">→</span></span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </section>
  <section class="fifteen-why__life fifteen-why__width">
    <h2>{{ section.settings.life_heading | escape }}</h2>
    <div class="rte">{{ section.settings.life_text }}</div>
    <div class="fifteen-why__moments">
      {% assign moments = 'School,Work,Gym,Travel,Bedside' | split: ',' %}
      {% for moment in moments %}
        <div>{% render 'fifteen-moment-icon', name: moment %}<span>{{ moment }}</span></div>
      {% endfor %}
    </div>
  </section>
  <section class="fifteen-why__cta">
    <div class="fifteen-why__width">
      <h2>{{ section.settings.cta_heading | escape }}</h2>
      <div class="rte">{{ section.settings.cta_text }}</div>
      {% if section.settings.cta_label != blank %}
        <a class="fifteen-why__button" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </section>
</article>

{% stylesheet %}
.fifteen-why { color: var(--why-navy); background: var(--why-cream); overflow: hidden; }
.fifteen-why * { box-sizing: border-box; }
.fifteen-why__width { max-width: 1440px; margin-inline: auto; padding-inline: clamp(1.25rem, 5vw, 5rem); }
.fifteen-why h1, .fifteen-why h2, .fifteen-why h3 { color: inherit; font-family: var(--font-heading--family); font-weight: 800; letter-spacing: -.055em; margin: 0; }
.fifteen-why h1 { font-size: clamp(2.8rem, 5.5vw, 5.5rem); line-height: 1; }
.fifteen-why h2 { font-size: clamp(2rem, 3.5vw, 3.5rem); line-height: 1.08; }
.fifteen-why .rte { font-size: clamp(1rem, 1.2vw, 1.2rem); line-height: 1.7; }
.fifteen-why .rte p { margin: 0 0 1rem; }
.fifteen-why__eyebrow { font-size: .8rem; color: var(--why-pink); font-weight: 800; letter-spacing: .14em; margin: 0 0 1rem; }
.fifteen-why__hero { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(3rem, 6vw, 6rem); }
.fifteen-why__hero .rte { max-width: 35rem; }
.fifteen-why__underline { display: block; width: min(100%, 25rem); height: 1.25rem; margin: .7rem 0 1.5rem; color: var(--why-pink); transform: rotate(-1deg); overflow: visible; }
.fifteen-why__hero-art { display: grid; place-items: center; min-height: 25rem; padding: 3rem 1rem; background: linear-gradient(135deg, #92d7ef, #edf9fd); border-radius: 45% 1.5rem 40% 1.5rem; }
.fifteen-why__badge { display: flex; align-items: center; flex-direction: column; justify-content: center; width: min(100%, 19rem); aspect-ratio: 1; padding: 1.5rem; border-radius: 50%; background: var(--why-cream); color: var(--why-pink); transform: rotate(-7deg); font-family: var(--font-heading--family); font-weight: 800; }
.fifteen-why__badge > span { font-size: clamp(1.1rem, 1.7vw, 1.7rem); line-height: 1.2; }
.fifteen-why__badge strong { font-size: clamp(4.5rem, 8vw, 8rem); letter-spacing: -.07em; line-height: 1; }
.fifteen-why__benefits { padding-bottom: clamp(3rem, 6vw, 6rem); }
.fifteen-why__section-heading { text-align: center; max-width: 44rem; margin: 0 auto 2.5rem; }
.fifteen-why__section-heading .rte { margin-top: 1.2rem; }
.fifteen-why__benefit-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.3rem; }
.fifteen-why__benefit { background: #fff; padding: clamp(1.5rem, 2.5vw, 2.5rem); border-radius: 1.2rem; }
.fifteen-why__benefit:nth-child(2n) { background: #fce7ee; }
.fifteen-why__benefit img { display: block; width: 3.5rem; height: auto; margin-bottom: 1.5rem; }
.fifteen-why__benefit h3 { font-size: 1.4rem; line-height: 1.15; margin-bottom: .8rem; }
.fifteen-why__benefit p { font-size: 1rem; line-height: 1.6; margin: 0; }
.fifteen-why__portion-wrap { background: var(--why-navy); color: #fff; }
.fifteen-why__portion { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(3rem, 5vw, 5rem); }
.fifteen-why__formats { padding-block: clamp(3rem, 6vw, 6rem); text-align: center; }
.fifteen-why__formats .fifteen-why__underline { margin-inline: auto; }
.fifteen-why__formats .rte { max-width: 42rem; margin-inline: auto; }
.fifteen-why__life { text-align: center; padding-bottom: clamp(3rem, 6vw, 6rem); }
.fifteen-why__life .rte { max-width: 44rem; margin: 1.2rem auto 2rem; }
.fifteen-why__moments { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); max-width: 44rem; margin: 0 auto; gap: 1rem; }
.fifteen-why__moments > div { display: flex; flex-direction: column; align-items: center; gap: .7rem; font-weight: 750; font-size: .9rem; }
.fifteen-why__moments svg { display: block; width: min(100%, 3.5rem); height: auto; }
.fifteen-why__cta { padding-block: clamp(3rem, 5vw, 5rem); text-align: center; background: #f9ddd3; }
.fifteen-why__cta .rte { margin-top: 1rem; }
.fifteen-why__button { display: inline-flex; align-items: center; gap: 1rem; border-radius: 99rem; background: var(--why-pink); color: #fff; font-size: .85rem; font-weight: 800; padding: 1rem 1.8rem; text-decoration: none; margin-top: 1rem; }
.fifteen-why__button:focus-visible { outline: 3px solid var(--why-navy); outline-offset: 4px; }
@media (max-width: 989px) { .fifteen-why__benefit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 749px) { .fifteen-why__hero, .fifteen-why__portion { grid-template-columns: minmax(0, 1fr); } .fifteen-why__hero-art { min-height: 20rem; } .fifteen-why__moments { gap: .5rem; } .fifteen-why__moments > div { font-size: .75rem; } }
@media (max-width: 450px) { .fifteen-why__benefit-grid { grid-template-columns: minmax(0, 1fr); } }
@media (hover: hover) and (prefers-reduced-motion: no-preference) { .fifteen-why__button { transition: transform .2s ease; } .fifteen-why__button:hover { transform: translateY(-2px); } }
{% endstylesheet %}

