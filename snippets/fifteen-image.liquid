{%- comment -%}
  Catalog image renderer with a narrowly scoped packaging refresh. Unmatched
  image IDs use Shopify's normal image pipeline, including future admin uploads.
{%- endcomment -%}
{%- capture replacement -%}{%- render 'fifteen-image-asset', image: image -%}{%- endcapture -%}
{%- assign replacement = replacement | strip -%}
{%- assign image_alt = alt | default: image.alt -%}
{%- if replacement != blank -%}
  {%- assign small = replacement | append: '-240.webp' -%}
  {%- assign medium = replacement | append: '-600.webp' -%}
  {%- assign large = replacement | append: '-1200.webp' -%}
  <img src="{{ large | asset_url }}"
    srcset="{{ small | asset_url }} 240w, {{ medium | asset_url }} 600w, {{ large | asset_url }} {% if replacement == 'fifteen-new-spheres' %}1024{% else %}1200{% endif %}w"
    sizes="{{ sizes | default: '100vw' }}" width="1200" height="{% if replacement == 'fifteen-new-spheres' %}1800{% else %}1200{% endif %}"
    alt="{{ image_alt | escape }}" loading="{{ loading | default: 'lazy' }}"
    {% if class != blank %}class="{{ class }}"{% endif %}
    {% if style != blank %}style="{{ style }}"{% endif %}
    {% if image_ref != blank %}ref="{{ image_ref }}"{% endif %}
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    data-media-id="{{ media_id | default: image.id }}" data_max_resolution="{{ large | asset_url }}">
{%- else -%}
  {{- image | image_url: width: 3840 | image_tag: widths: widths, sizes: sizes, alt: image_alt, loading: loading, class: class, style: style, ref: image_ref, fetchpriority: fetchpriority, data_max_resolution: high_res_url, data-media-id: media_id -}}
{%- endif -%}
